# Deployment bundles built with `npm run build:static`. Generated output, not
# source: reproducible any time, and stale the moment anything changes. The
# pattern is deliberately broad - it used to name each bundle individually and
# a differently-named one slipped through.
*.zip

node_modules/
.next/
out/
build/
.env
.env.local
.DS_Store
*.tsbuildinfo
next-env.d.ts
/.data/
coverage/
.static-build/

# Throwaway tooling written at the repo root so it can resolve node_modules -
# screenshot drivers, overflow checks, one-off probes. `git add -A` will
# otherwise sweep these into a commit, which is how .shot.mjs got in once.
/.shot.mjs
/.overflow.mjs
/.smoke*.mjs

