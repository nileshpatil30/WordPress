{
  "name": "homecostdoctor",
  "version": "0.1.0",
  "private": true,
  "description": "CostSignal - US home project cost intelligence platform (Phase 1: roofing)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "tsx scripts/seed-postgres.ts",
    "ingest:bls": "tsx scripts/ingest-bls-oews.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:extract": "tsx scripts/check-extraction.ts",
    "build:static": "bash scripts/build-static.sh",
    "ingest:materials": "tsx scripts/ingest-materials.ts",
    "ingest:ppi": "tsx scripts/ingest-ppi.ts",
    "collect:prices": "tsx scripts/collect-prices.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
