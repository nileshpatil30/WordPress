# ---------------------------------------------------------------------------
# CostSignal environment
# ---------------------------------------------------------------------------

# Public site URL, used for canonical tags, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage driver.
#   (unset)  -> JSON file store at ./.data/store.json (default; zero infra)
#   set      -> PostgreSQL store (run `npm run db:schema && npm run db:seed` first)
# DATABASE_URL=postgresql://user:pass@localhost:5432/costsignal

# Allows the JSON store to persist admin edits + submissions to disk.
# Leave true locally, false on read-only/serverless filesystems.
ALLOW_FILE_WRITES=true

# Signing secret for the admin session cookie. Required in production, minimum
# 16 characters. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Admin accounts are rows in admin_users, created from the CLI. There is no
# default account and no shared password:
#   npm run admin:create -- --email you@example.com --role owner

# Escape hatch: run in production against the JSON file store anyway. Only set
# this if you understand that writes are lost on a read-only filesystem.
# ALLOW_JSON_STORE_IN_PRODUCTION=false

# Quote upload / AI extraction. Without this, /api/quote-extract returns a clear
# 503 and the manual entry path continues to work.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: API keys allowed to call /api/v1/* (comma separated).
# PARTNER_API_KEYS=demo-key-1,demo-key-2
